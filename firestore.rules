rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function principalUid() {
      return get(/databases/$(database)/documents/vc_config/admins).data.principalUid;
    }

    function isPrincipal() {
      return signedIn()
        && exists(/databases/$(database)/documents/vc_config/admins)
        && request.auth.uid == principalUid();
    }

    function spaceCreator(spaceId) {
      return get(/databases/$(database)/documents/vc_spaces/$(spaceId)).data.createdBy;
    }

    function isSpaceCreator(spaceId) {
      return signedIn() && request.auth.uid == spaceCreator(spaceId);
    }

    function memberPath(spaceId) {
      return /databases/$(database)/documents/vc_spaces/$(spaceId)/members/$(request.auth.uid);
    }

    function memberDoc(spaceId) {
      return get(memberPath(spaceId));
    }

    function memberHasPerm(spaceId, perm) {
      return signedIn()
        && exists(memberPath(spaceId))
        && memberDoc(spaceId).data.perms[perm] == true;
    }

    function canEditSpace(spaceId) {
      return isSpaceCreator(spaceId) || memberHasPerm(spaceId, 'edit_space');
    }

    function canManageRooms(spaceId) {
      return isSpaceCreator(spaceId) || memberHasPerm(spaceId, 'manage_rooms');
    }

    function canModChat(spaceId) {
      return isSpaceCreator(spaceId) || memberHasPerm(spaceId, 'mod_chat');
    }

    function canAssignRoles(spaceId) {
      return isSpaceCreator(spaceId) || memberHasPerm(spaceId, 'assign_roles');
    }

    // Join: add only self. Leave: remove only self.
    // Kick / edit: remove exactly one other member (size −1, kicker stays).
    function memberIdsJoinSelf() {
      return request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && !resource.data.memberIds.hasAny([request.auth.uid]);
    }

    function memberIdsLeaveSelf() {
      return resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
        && resource.data.memberIds.hasAny([request.auth.uid])
        && !request.resource.data.memberIds.hasAny([request.auth.uid]);
    }

    function memberIdsRemoveOneOther(spaceId) {
      return resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
        && resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && (
          isSpaceCreator(spaceId)
          || memberHasPerm(spaceId, 'kick')
          || memberHasPerm(spaceId, 'edit_space')
        );
    }

    function memberIdsChangeAllowed(spaceId) {
      return memberIdsJoinSelf()
        || memberIdsLeaveSelf()
        || memberIdsRemoveOneOther(spaceId);
    }

    // After Google/email re-login, claim ownership if the previous createdBy
    // Auth UID belongs to the same email and is no longer in memberIds.
    function reclaimCreatorSameEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.resource.data.createdBy == request.auth.uid
        && resource.data.createdBy != request.auth.uid
        && exists(/databases/$(database)/documents/vc_users/$(resource.data.createdBy))
        && get(/databases/$(database)/documents/vc_users/$(resource.data.createdBy)).data.email is string
        && get(/databases/$(database)/documents/vc_users/$(resource.data.createdBy)).data.email.lower()
          == request.auth.token.email.lower()
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && !request.resource.data.memberIds.hasAny([resource.data.createdBy]);
    }

    // Creator / edit_space: any fields.
    // Join/leave/kick: memberIds (±1) and optional roomCount.
    // manage_events holders may also touch events.
    // mod_chat holders may update chatAutomation only.
    function spaceUpdateAllowed(spaceId) {
      return signedIn() && (
        request.auth.uid == resource.data.createdBy
        || memberHasPerm(spaceId, 'edit_space')
        || (
          memberHasPerm(spaceId, 'manage_events')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['events'])
        )
        || (
          canModChat(spaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatAutomation'])
        )
        || (
          canManageRooms(spaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roomCount'])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roomCount'])
          && memberIdsChangeAllowed(spaceId)
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && memberIdsChangeAllowed(spaceId)
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'createdBy'])
          && reclaimCreatorSameEmail()
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAny([request.auth.uid])
          && !request.resource.data.memberIds.hasAny([resource.data.createdBy])
        )
      );
    }

    function sameAccountEmail(uid) {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/vc_users/$(uid))
        && get(/databases/$(database)/documents/vc_users/$(uid)).data.email is string
        && get(/databases/$(database)/documents/vc_users/$(uid)).data.email.lower()
          == request.auth.token.email.lower();
    }

    function tagOwnerOrderOnly(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayOrder', 'displayOrderUpdatedAt']);
    }

    // Role assigners may only change roleIds / perms on members (not the creator).
    function memberRoleAssignUpdate(spaceId, uid) {
      return canAssignRoles(spaceId)
        && uid != spaceCreator(spaceId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['roleIds', 'perms']);
    }

    match /vc_users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /vc_user_tags/{uid} {
      allow read: if signedIn();
      allow create, delete: if isPrincipal();
      allow update: if isPrincipal() || tagOwnerOrderOnly(uid);
    }

    match /vc_config/admins {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/vc_config/admins)
        && request.resource.data.principalUid == request.auth.uid;
      allow update: if isPrincipal()
        && request.resource.data.principalUid == resource.data.principalUid;
      allow delete: if false;
    }

    match /vc_config/tag_catalog {
      allow read: if signedIn();
      allow create, update: if isPrincipal();
      allow delete: if false;
    }

    // Friend requests — top-level (NOT nested under vc_spaces).
    // Only sender + receiver can see / mutate.
    // Status flow: pending → accepted | ignored (or deleted entirely).
    // IMPORTANT: clients must query with where(fromUserId|toUserId == auth.uid).
    // An unfiltered collection listen will fail with permission-denied.
    match /vc_friend_requests/{requestId} {
      // Allow get of missing docs (idempotent create checks) + own docs.
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/vc_friend_requests/$(requestId))
        || resource.data.fromUserId == request.auth.uid
        || resource.data.toUserId == request.auth.uid
      );
      allow list: if signedIn() && (
        resource.data.fromUserId == request.auth.uid
        || resource.data.toUserId == request.auth.uid
      );
      // Only the sender can create a pending request addressed to someone else.
      allow create: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending';
      // Receiver can accept/ignore. Sender can re-send if previously ignored.
      allow update: if signedIn() && (
        (resource.data.toUserId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'ignored']
          && request.resource.data.fromUserId == resource.data.fromUserId
          && request.resource.data.toUserId == resource.data.toUserId)
        || (resource.data.fromUserId == request.auth.uid
          && resource.data.status == 'ignored'
          && request.resource.data.status == 'pending'
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.toUserId == resource.data.toUserId)
      );
      // Both parties can delete (cancel / unfriend).
      allow delete: if signedIn() && (
        resource.data.fromUserId == request.auth.uid
        || resource.data.toUserId == request.auth.uid
      );
    }

    match /vc_spaces/{spaceId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if spaceUpdateAllowed(spaceId);
      allow delete: if isSpaceCreator(spaceId);

      match /roles/{roleId} {
        allow read: if signedIn();
        allow create, update, delete: if isSpaceCreator(spaceId);
      }

      match /room_groups/{groupId} {
        allow read: if signedIn();
        allow create, update, delete: if canManageRooms(spaceId);
      }

      match /members/{uid} {
        allow read: if signedIn();
        // Create own membership row only. Delete: self, kick/creator, or
        // leftover Auth UID for the same email (re-login cleanup).
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (
          request.auth.uid == uid
          || isSpaceCreator(spaceId)
          || memberHasPerm(spaceId, 'kick')
          || sameAccountEmail(uid)
        );
        allow update: if signedIn() && (
          isSpaceCreator(spaceId)
          || memberRoleAssignUpdate(spaceId, uid)
          || (
            request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['roleIds', 'perms'])
          )
        );
      }

      // Event RSVPs: any signed-in member can read, write own row only.
      // rsvpId convention: `${eventId}_${userId}` — the userId in the
      // document must match the auth uid, and the doc ID must end with
      // that uid. Creator can delete any row for moderation.
      match /event_rsvps/{rsvpId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == request.resource.data.userId
          && (request.resource.data.status == 'going'
              || request.resource.data.status == 'not_going')
          && rsvpId.matches('.*_' + request.auth.uid + '$');
        allow delete: if signedIn()
          && (rsvpId.matches('.*_' + request.auth.uid + '$')
              || isSpaceCreator(spaceId));
      }

      match /rooms/{roomId} {
        allow read: if signedIn();
        allow create, delete: if canManageRooms(spaceId);
        allow update: if canManageRooms(spaceId)
          || (
            canModChat(spaceId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['chatLocked', 'slowModeSeconds', 'lobby', 'rules'])
          );

        match /messages/{messageId} {
          allow read: if signedIn();
          allow create: if signedIn() && (
            canModChat(spaceId)
            || get(/databases/$(database)/documents/vc_spaces/$(spaceId)/rooms/$(roomId)).data.chatLocked != true
            || (
              request.resource.data.kind == 'lobby_event'
              && request.resource.data.authorId == request.auth.uid
              && get(/databases/$(database)/documents/vc_spaces/$(spaceId)/rooms/$(roomId)).data.lobby.enabled == true
            )
          );
          allow update, delete: if signedIn() && (
            resource.data.authorId == request.auth.uid
            || canModChat(spaceId)
          );
        }

        match /scheduled_announcements/{announceId} {
          allow read: if signedIn() && canModChat(spaceId);
          allow create, update, delete: if canModChat(spaceId);
        }

        match /peers/{peerId} {
          allow read: if signedIn();
          allow write: if signedIn() && request.auth.uid == peerId;
        }

        match /signals/{signalId} {
          allow read, write: if signedIn();
        }

        match /thoughts/{thoughtId} {
          allow read, create: if signedIn();
          allow update, delete: if signedIn()
            && resource.data.userId == request.auth.uid;
        }
      }
    }
  }
}
