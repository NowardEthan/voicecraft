{
  "name": "voicecraft",
  "version": "0.3.2",
  "description": "P2P voice/video chat for LAN",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --publish never",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder --publish never",
    "release": "vite build && electron-builder --publish always",
    "dev:multi": "node scripts/dev-multi.cjs",
    "signaling": "node server/signaling-server.mjs",
    "all": "vite"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "voice",
    "video",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NowardEthan/voicecraft.git"
  },
  "dependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@iconify/react": "^6.0.2",
    "electron-updater": "^6.8.9",
    "emoji-picker-react": "^4.21.0",
    "firebase": "^12.18.0",
    "framer-motion": "^13.2.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.0",
    "lucide-react": "^1.41.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "firebase-tools": "^15.29.0",
    "google-auth-library": "^11.0.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.voicecraft.app",
    "productName": "VoiceCraft",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/livekit-server-sdk/**/*"
    ],
    "extraResources": [
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "public/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "resources/bin/voicecraft-audio.exe",
        "to": "voicecraft-audio.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NowardEthan",
        "repo": "voicecraft",
        "releaseType": "release"
      }
    ]
  }
}
