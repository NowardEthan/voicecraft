{
  "rules": {
    ".read": false,
    ".write": false,
    "vc_presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['state', 'lastChanged']) && (newData.child('state').val() == 'online' || newData.child('state').val() == 'offline')"
      }
    },
    "vc_space_presence": {
      "$spaceId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['state', 'lastChanged']) && (newData.child('state').val() == 'online' || newData.child('state').val() == 'offline')"
        }
      }
    },
    "vc_room_likes": {
      "$spaceId": {
        "$roomId": {
          ".read": "auth != null",
          "$msgId": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid",
              ".validate": "newData.val() === true"
            }
          }
        }
      }
    },
    "vc_msg_reactions": {
      "$spaceId": {
        "$roomId": {
          ".read": "auth != null",
          "$msgId": {
            "$emoji": {
              "$uid": {
                ".write": "auth != null && auth.uid == $uid",
                ".validate": "newData.val() === true"
              }
            }
          }
        }
      }
    }
  }
}
