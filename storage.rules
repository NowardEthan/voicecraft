rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSpaceMember(spaceId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/vc_spaces/$(spaceId)/members/$(request.auth.uid));
    }

    function roomExists(spaceId, roomId) {
      return firestore.exists(/databases/(default)/documents/vc_spaces/$(spaceId)/rooms/$(roomId));
    }

    function canModChat(spaceId) {
      return isSpaceMember(spaceId) && (
        firestore.get(/databases/(default)/documents/vc_spaces/$(spaceId)).data.createdBy == request.auth.uid
        || firestore.get(/databases/(default)/documents/vc_spaces/$(spaceId)/members/$(request.auth.uid)).data.perms.mod_chat == true
      );
    }

    function validChatMime() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/json'
        || request.resource.contentType == 'application/zip'
        || request.resource.contentType == 'application/vnd.rar'
        || request.resource.contentType.matches('text/.*')
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType.matches('application/vnd\\..*')
        || request.resource.contentType == 'application/octet-stream'
        || request.resource.contentType.matches('audio/.*')
        || request.resource.contentType.matches('video/.*');
    }

    match /voicecraft/covers/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /voicecraft/room-covers/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /voicecraft/announce-assets/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /voicecraft/announce-covers/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /voicecraft/avatars/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /voicecraft/space-fonts/{spaceId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 4 * 1024 * 1024
        && (
          request.resource.contentType.matches('font/.*')
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType.matches('application/font-.*')
          || request.resource.contentType.matches('application/x-font-.*')
        );
    }

    // Current client paths contain exactly one file segment. New writes carry
    // uploaderId custom metadata, allowing ownership enforcement in addition
    // to Space membership and a real room under that Space.
    match /voicecraft/chat/{spaceId}/{roomId}/{fileName} {
      allow read: if isSpaceMember(spaceId) && roomExists(spaceId, roomId);
      allow create: if isSpaceMember(spaceId)
        && roomExists(spaceId, roomId)
        && request.resource.size < 25 * 1024 * 1024
        && validChatMime()
        && request.resource.metadata.get('uploaderId', '') == request.auth.uid;
      allow update: if isSpaceMember(spaceId)
        && roomExists(spaceId, roomId)
        && request.resource.size < 25 * 1024 * 1024
        && validChatMime()
        && request.resource.metadata.get('uploaderId', '') == resource.metadata.get('uploaderId', '')
        && (
          resource.metadata.get('uploaderId', '') == request.auth.uid
          || canModChat(spaceId)
        );
      allow delete: if isSpaceMember(spaceId)
        && roomExists(spaceId, roomId)
        && (
          resource.metadata.get('uploaderId', '') == request.auth.uid
          || canModChat(spaceId)
        );
    }
  }
}
